# Kopieer dit bestand naar .env.local en vul de waarden in.

# ── Supabase ──────────────────────────────────────────────────────────────────
# Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Webhook security (optional maar aanbevolen) ───────────────────────────────
# Stel in als een willekeurige geheime string en stuur mee als
# x-webhook-secret header vanuit je websites.
WEBHOOK_SECRET=vervang-dit-met-een-sterk-geheim
